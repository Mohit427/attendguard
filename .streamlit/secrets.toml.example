# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud -> App settings -> Secrets.
# SMTP_PASS must be a Gmail App Password (Google Account -> Security -> 2-Step Verification -> App passwords),
# not your normal Gmail password.
SMTP_USER = "your.address@gmail.com"
SMTP_PASS = "abcdefghijklmnop"

# Optional - automated voice calls (Twilio). Trial accounts can only call verified numbers.
TWILIO_ACCOUNT_SID = "ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN = "your_auth_token"
TWILIO_FROM_NUMBER = "+14155550100"
TEST_PHONE = "+919876543210"
